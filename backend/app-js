require("dotenv").config();
const express = require("express");
const pool = require("./db");

const app = express();
const PORT = 3000;

app.get("/api/ping-db", async (req, res) => {
  try {
    const result = await pool.query("SELECT 1");
    res.json({ status: "Conexión OK", result: result.rows });
  } catch (error) {
    console.error(error);
    res.status(500).json({ status: "Error de conexión", error: error.message });
  }
});

app.listen(PORT, () => {
  console.log(`Backend escuchando en puerto ${PORT}`);
});
